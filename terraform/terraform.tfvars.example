# AWS Configuration
aws_region   = "ap-southeast-1"
project_name = "ecs-s3-mount"
environment  = "test"

# S3 Configuration
bucket_name = "ecs-s3-test-bucket"

# VPC Configuration
vpc_cidr                 = "10.109.0.0/16"
availability_zones_count = 3
public_subnet_cidrs      = ["10.109.1.0/24", "10.109.2.0/24", "10.109.3.0/24"]
enable_dns_hostnames     = true
enable_dns_support       = true
map_public_ip_on_launch  = true

# EC2 Instance Configuration
instance_type = "t3.xlarge"  # 4 vCPU, 16 GB Memory
# Other options:
# - t3.medium   (2 vCPU, 4 GB)
# - t3.large    (2 vCPU, 8 GB)
# - t3.2xlarge  (8 vCPU, 32 GB)
# - m5.xlarge   (4 vCPU, 16 GB)
# - m5.2xlarge  (8 vCPU, 32 GB)

# Auto Scaling Group Configuration
asg_min_size         = 1
asg_max_size         = 3
asg_desired_capacity = 1

# ECS Task Configuration
task_cpu    = "2048"  # 0.25 vCPU
task_memory = "8192"  # 512 MB
# CPU/Memory combinations for EC2 launch type:
# - 256 CPU / 512-2048 MB
# - 512 CPU / 1024-4096 MB
# - 1024 CPU / 2048-8192 MB
# - 2048 CPU / 4096-16384 MB

# ECS Service Configuration
ecs_service_desired_count = 1

# CloudWatch Logs Configuration
log_retention_days = 7
# Options: 1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1827, 3653

# Additional Tags (Optional)
#additional_tags = {
#  Owner       = "DevOps Team"
#  CostCenter  = "Engineering"
#  Compliance  = "None"
#}
